#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "yam"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "yam"
{
    over "Physics"
    {
        over "joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "joint3" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "joint4" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "joint5" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "joint6" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "joint7" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "joint8" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}


#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "yam"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "yam"
{
    over "Physics"
    {
        over "joint1" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint2" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint3" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint4" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint5" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint6" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint7" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint8" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "joint1_actuator"
        {
            uniform double mjc:forceRange:max = 1
            uniform double mjc:forceRange:min = -1
            custom rel mjc:target
            append rel mjc:target = </yam/Physics/joint1>
        }

        def MjcActuator "joint2_actuator"
        {
            uniform double mjc:forceRange:max = 1
            uniform double mjc:forceRange:min = -1
            custom rel mjc:target
            append rel mjc:target = </yam/Physics/joint2>
        }

        def MjcActuator "joint3_actuator"
        {
            uniform double mjc:forceRange:max = 1
            uniform double mjc:forceRange:min = -1
            custom rel mjc:target
            append rel mjc:target = </yam/Physics/joint3>
        }

        def MjcActuator "joint4_actuator"
        {
            uniform double mjc:forceRange:max = 1
            uniform double mjc:forceRange:min = -1
            custom rel mjc:target
            append rel mjc:target = </yam/Physics/joint4>
        }

        def MjcActuator "joint5_actuator"
        {
            uniform double mjc:forceRange:max = 1
            uniform double mjc:forceRange:min = -1
            custom rel mjc:target
            append rel mjc:target = </yam/Physics/joint5>
        }

        def MjcActuator "joint6_actuator"
        {
            uniform double mjc:forceRange:max = 1
            uniform double mjc:forceRange:min = -1
            custom rel mjc:target
            append rel mjc:target = </yam/Physics/joint6>
        }

        def MjcActuator "joint7_actuator"
        {
            uniform double mjc:forceRange:max = 1
            uniform double mjc:forceRange:min = -1
            custom rel mjc:target
            append rel mjc:target = </yam/Physics/joint7>
        }

        def MjcActuator "joint8_actuator"
        {
            uniform double mjc:forceRange:max = 1
            uniform double mjc:forceRange:min = -1
            custom rel mjc:target
            append rel mjc:target = </yam/Physics/joint8>
        }
    }
}

